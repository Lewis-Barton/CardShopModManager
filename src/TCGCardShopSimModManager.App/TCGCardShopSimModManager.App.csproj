<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TCGCardShopSimModManager.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Description>Desktop mod manager for TCG Card Shop Simulator.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!-- Override Avalonia's older Linux DBus dependency with a patched release. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TCGCardShopSimModManager.Core\TCGCardShopSimModManager.Core.csproj" />
  </ItemGroup>

</Project>
