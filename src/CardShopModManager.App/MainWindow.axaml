<!--
  MainWindow.axaml holds the layout (the "what's on screen") as XAML.
  MainWindow.cs holds the behaviour (the "what happens on click") as code-behind.

  Notes for reading this:
  - x:Name="..." gives a control an id we can use in code-behind. The matching
    field (_gameBox, _log, ...) is generated for us by Avalonia's name generator.
  - Grid.Row / Grid.Column place a child into a specific cell of the parent Grid.
  - Avalonia's Grid has no row/column "spacing" property (that's a UWP thing), so
    gaps come from Margin, like CSS margin between block elements.
  - Classes="header" / Classes="card" hook into the class-based styles in
    App.axaml (the XAML equivalent of CSS classes).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CardShopModManager.App.MainWindow"
        Title="Card Shop Mod Manager"
        Width="980" Height="640">

  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Classes="header" Text="Card Shop Mod Manager" />
      <TextBlock Classes="subtitle" Text="Install and manage mods for TCG Card Shop Simulator" />
    </StackPanel>

    <!-- Game folder -->
    <Grid Grid.Row="1" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
      <TextBox x:Name="_gameBox"
               Watermark="Game folder (where Card Shop Simulator is installed)" />
      <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Click="OnPickGameFolder" />
    </Grid>

    <!-- Manifest -->
    <Grid Grid.Row="2" Margin="0,6,0,0" ColumnDefinitions="*,Auto">
      <TextBox x:Name="_manifestBox" Watermark="path to manifest.json" />
      <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Click="OnPickManifestFile" />
    </Grid>

    <!-- Source folder -->
    <Grid Grid.Row="3" Margin="0,6,0,0" ColumnDefinitions="*,Auto">
      <TextBox x:Name="_sourceBox" Watermark="folder containing the mod archives" />
      <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Click="OnPickSourceFolder" />
    </Grid>

    <!-- Mod name to uninstall (this input was missing from the old UI) -->
    <TextBox Grid.Row="4" Margin="0,6,0,0" x:Name="_uninstallBox" Watermark="mod name to uninstall" />

    <!-- Primary actions -->
    <StackPanel Grid.Row="5" Margin="0,6,0,0" Orientation="Horizontal" Spacing="8">
      <Button Content="Validate" Click="OnValidateClick" />
      <Button Content="Plan" Click="OnPlanClick" />
      <Button Content="Install" Click="OnInstallClick" />
      <Button Content="Uninstall" Click="OnUninstallClick" />
    </StackPanel>

    <!-- Utilities -->
    <StackPanel Grid.Row="6" Margin="0,6,0,0" Orientation="Horizontal" Spacing="8">
      <Button Content="List mods" Click="OnListModsClick" />
      <Button Content="Enable" Click="OnEnableClick" />
      <Button Content="Disable" Click="OnDisableClick" />
      <Button Content="Update check" Click="OnUpdateCheckClick" />
      <Button Content="Export bundle" Click="OnExportBundleClick" />
    </StackPanel>

    <!-- Progress (hidden until a job runs) -->
    <ProgressBar Grid.Row="7" Margin="0,6,0,0" x:Name="_progress"
                 IsIndeterminate="True" IsVisible="False" Height="6" />

    <!-- Bottom split: log + installed mods, each in a card -->
    <Grid Grid.Row="8" Margin="0,6,0,0" ColumnDefinitions="*,260">
      <Border Classes="card" Grid.Column="0" Margin="0,0,12,0">
        <TextBox x:Name="_log"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas" Text="Card Shop Mod Manager" />
      </Border>

      <Border Classes="card" Grid.Column="1">
        <!-- DockPanel bounds the ListBox height: the header docks to the top and
             the ListBox fills the rest, so its scrollbar appears only when the
             mod list overflows the card. -->
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Classes="header" FontSize="14" Text="Installed mods" />
          <ListBox x:Name="_modsList" />
        </DockPanel>
      </Border>
    </Grid>

  </Grid>
</Window>
